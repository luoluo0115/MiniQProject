/* 小Q · 全局样式与设计令牌
 * 视觉令牌对齐原型 prototype.html（9 色系统）。
 * 吉祥物「词豆」角色配色由 utils/svg.js 的 MAP 独立管理（IP 设定，勿混用）。
 *
 * ── UI 色板令牌（各页 wxss 直接引用同一组十六进制）──
 *   appbg  #F3F7FF   页面底色
 *   ink    #202634   主文字
 *   sub    #7D8799   辅文字
 *   coral  #FF704E   活动 / 强调
 *   pinky  #FF6B8B   主 CTA / AI 口语
 *   sky2   #3D8BFF   分级阅读
 *   grass  #35B979   跟读 / 家长
 *   sunny  #FFCA4B   金币 / 奖励
 *   grape  #7968ED   背单词 / 测评
 *   tabact #596EF2   Tab 活跃色
 * ── 圆角阶梯 ──  大卡 28rpx / 按钮·中卡 16rpx / 小卡·tag 12rpx
 */

page {
  background: #F3F7FF;
  color: #202634;
  font-family: -apple-system, "PingFang SC", "Noto Sans SC", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, button, scroll-view, image { box-sizing: border-box; }

/* ── 文本色工具类 ── */
.c-ink   { color: #202634; }
.c-sub   { color: #7D8799; }
.c-coral { color: #FF704E; }
.c-pinky { color: #FF6B8B; }
.c-sky   { color: #3D8BFF; }
.c-grass { color: #35B979; }
.c-sunny { color: #FFCA4B; }
.c-grape { color: #7968ED; }

/* ── 阴影 ── */
.soft    { box-shadow: 0 8rpx 22rpx rgba(42, 72, 126, .08); }
.soft-lg { box-shadow: 0 16rpx 36rpx rgba(42, 72, 126, .16); }

/* ── 卡片 / 玻璃态 / 药丸 ── */
.card {
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 22rpx rgba(42, 72, 126, .08);
}
.glass {
  background: rgba(255, 255, 255, .72);
  border: 1rpx solid rgba(95, 147, 188, .16);
  box-shadow: 0 5rpx 14rpx rgba(69, 119, 160, .08);
  backdrop-filter: blur(8rpx);
}
.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
}

/* ── 主 CTA 按钮（pinky → coral 渐变）── */
.btn-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 26rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FF6B8B, #FF704E);
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  box-shadow: 0 12rpx 26rpx rgba(255, 112, 78, .32);
}
.btn-cta::after { border: none; }

/* ── 通用页容器：底部给 tabbar 预留安全区 ── */
.q-page {
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}
.tab-spacer { height: calc(160rpx + env(safe-area-inset-bottom)); }

/* ── 分区间距 ── */
.section { padding: 0 28rpx; margin-top: 28rpx; }
.eyebrow {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  color: #7968ED;
  text-transform: uppercase;
}

/* ── 按压反馈 ── */
.pressed { transform: scale(.97); opacity: .92; }

/* ── 动效 ── */
@keyframes m-bob {
  0%, 100% { transform: translateY(0) rotate(-1deg); }
  50%      { transform: translateY(-6rpx) rotate(1deg); }
}
@keyframes m-pop {
  0%   { transform: scale(.4); opacity: 0; }
  100% { transform: scale(1);  opacity: 1; }
}
@keyframes float-a {
  0%, 100% { transform: translateY(0) rotate(-3deg); }
  50%      { transform: translateY(-10rpx) rotate(3deg); }
}
@keyframes q-fadein {
  from { opacity: 0; transform: translateY(12rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.anim-bob   { animation: m-bob 1.6s ease-in-out infinite; }
.anim-pop   { animation: m-pop .5s cubic-bezier(.2, 1.4, .5, 1); }
.anim-float { animation: float-a 3.2s ease-in-out infinite; }
.anim-in    { animation: q-fadein .28s ease-out both; }
