.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  padding: 10rpx 12rpx calc(10rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, .94);
  border-top: 1rpx solid rgba(95, 147, 188, .12);
  box-shadow: 0 -8rpx 24rpx rgba(42, 72, 126, .06);
  backdrop-filter: blur(10rpx);
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 0;
  color: #B7BEC9;
  transition: transform .12s ease;
}
.tab:active { transform: scale(.92); }
.tab .ico { font-size: 40rpx; line-height: 1; filter: grayscale(.4) opacity(.7); }
.tab .txt { font-size: 20rpx; font-weight: 700; }
.tab.on { color: #596EF2; }
.tab.on .ico { filter: none; }
