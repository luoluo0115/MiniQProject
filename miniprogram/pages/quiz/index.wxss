/* 趣味闯关 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F6F8;
}
.scroller { flex: 1; }

.quiz-head {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 40rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 6rpx 18rpx rgba(43, 47, 56, .07);
}
.quiz-title { font-size: 28rpx; font-weight: 800; color: #FF6B4A; }
.quiz-combo { font-size: 24rpx; font-weight: 800; color: #FF6B4A; }

.q-card {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 40rpx;
  padding: 32rpx;
  box-shadow: 0 6rpx 18rpx rgba(43, 47, 56, .07);
}
.q-art {
  width: 100%;
  height: 240rpx;
  background: #FEF2F2;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
  margin-bottom: 24rpx;
}
.q-options {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}
.opt {
  padding: 28rpx 0;
  border-radius: 32rpx;
  background: #F1F5F9;
  color: #2B2F38;
  font-size: 30rpx;
  font-weight: 800;
  text-align: center;
  transition: background .15s, color .15s;
}
.opt-right { background: #4FC378; color: #fff; }
.opt-wrong { background: #FEE2E2; color: #B91C1C; }

.prog-card {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 40rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(43, 47, 56, .07);
}
.prog-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.prog-title { font-size: 26rpx; font-weight: 800; color: #2B2F38; }
.prog-num { font-size: 24rpx; font-weight: 800; color: #FF6B4A; }
.prog-bar {
  margin-top: 16rpx;
  height: 20rpx;
  background: #F1F5F9;
  border-radius: 999rpx;
  overflow: hidden;
}
.prog-fill { height: 100%; background: linear-gradient(90deg, #FF6FA5, #FF6B4A); }

/* 通关态 */
.done-card {
  margin: 24rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 48rpx;
  text-align: center;
  box-shadow: 0 6rpx 18rpx rgba(43, 47, 56, .07);
}
.done-mascot { display: flex; justify-content: center; }
.done-title { font-size: 36rpx; font-weight: 800; color: #2B2F38; margin-top: 12rpx; }
.done-sub { font-size: 24rpx; color: #8A93A2; margin-top: 8rpx; line-height: 1.6; }
.done-btn {
  margin: 32rpx auto 0;
  display: inline-block;
  background: linear-gradient(90deg, #FF6FA5, #FF6B4A);
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
  padding: 22rpx 56rpx;
  border-radius: 28rpx;
}
