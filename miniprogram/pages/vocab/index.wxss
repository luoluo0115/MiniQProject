/* 背单词 · FSRS 翻卡 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F3F7FF;
}
.scroller { flex: 1; }
.tail { height: 40rpx; }

/* FSRS 头卡 */
.head-card {
  margin: 24rpx;
  border-radius: 32rpx;
  padding: 28rpx;
  background: linear-gradient(120deg, #7968ED, #596EF2);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 14rpx 30rpx rgba(121, 104, 237, .28);
}
.head-label { font-size: 22rpx; opacity: .9; }
.head-stat { font-size: 34rpx; font-weight: 800; margin-top: 6rpx; }
.head-badge {
  background: rgba(255, 255, 255, .25);
  font-size: 22rpx;
  font-weight: 800;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

/* 翻转闪卡 */
.flip-wrap {
  margin: 8rpx 24rpx 0;
  height: 640rpx;
  perspective: 1600rpx;
}
.flip-card {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform .5s;
}
.flip-card.is-flipped { transform: rotateY(180deg); }
.face {
  position: absolute;
  inset: 0;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  background: #fff;
  border-radius: 36rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 14rpx 32rpx rgba(42, 72, 126, .1);
}
.face-back {
  transform: rotateY(180deg);
  border: 3rpx solid rgba(53, 185, 121, .3);
}

/* 正面 */
.stage-pill {
  align-self: flex-end;
  background: rgba(121, 104, 237, .12);
  color: #7968ED;
  font-size: 22rpx;
  font-weight: 800;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}
.card-emoji { font-size: 130rpx; }
.front-mid { text-align: center; }
.card-word { font-size: 72rpx; font-weight: 800; color: #202634; }
.phonics-pill {
  display: inline-block;
  background: #F1F5F9;
  color: #7D8799;
  font-size: 22rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  margin-top: 16rpx;
}
.flip-hint { font-size: 22rpx; color: #7D8799; }

/* 背面 */
.back-mid { text-align: center; margin-top: 24rpx; }
.card-mean { font-size: 46rpx; font-weight: 800; color: #35B979; }
.card-example {
  font-size: 26rpx;
  color: #7D8799;
  margin-top: 24rpx;
  background: #F5F8FC;
  padding: 20rpx;
  border-radius: 20rpx;
}
.eval-grid {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
.eval-btn {
  padding: 24rpx 0;
  border-radius: 22rpx;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
  color: #fff;
}
.ev-forget { background: #FF704E; }
.ev-hard { background: #FFCA4B; color: #7A5A12; }
.ev-good { background: #3D8BFF; }
.ev-easy { background: #35B979; }

/* 完成态 */
.done-card {
  margin: 8rpx 24rpx 0;
  padding: 50rpx 40rpx;
  background: #fff;
  border-radius: 36rpx;
  text-align: center;
  box-shadow: 0 14rpx 32rpx rgba(42, 72, 126, .1);
}
.done-title { font-size: 38rpx; font-weight: 800; color: #202634; margin-top: 10rpx; }
.done-sub { font-size: 24rpx; color: #7D8799; margin: 10rpx 0 28rpx; }
.done-btn {
  display: inline-block;
  padding: 20rpx 60rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #7968ED, #596EF2);
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
}

/* 导出 */
.export-actions { margin: 24rpx 24rpx 0; display: flex; gap: 16rpx; }
.export-btn { flex: 1; margin: 0; border: 2rpx solid #C7BEF5; color: #6355C9; background: #fff; border-radius: 20rpx; font-size: 24rpx; }
.export-btn.primary { color: #fff; background: #7968ED; border-color: #7968ED; }
.export-btn::after { border: 0; }

/* 单词图鉴 */
.atlas {
  margin: 24rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 22rpx rgba(42, 72, 126, .08);
}
.atlas-left { display: flex; align-items: center; gap: 18rpx; }
.atlas-emoji { font-size: 48rpx; }
.atlas-title { font-size: 28rpx; font-weight: 800; color: #202634; }
.atlas-sub { font-size: 22rpx; color: #7D8799; margin-top: 4rpx; }
.atlas-bar {
  width: 180rpx;
  height: 16rpx;
  background: #F1F5F9;
  border-radius: 999rpx;
  overflow: hidden;
}
.atlas-fill { height: 100%; background: linear-gradient(90deg, #7968ED, #596EF2); }
