<!-- 背单词 · 艾宾浩斯 FSRS 翻卡 -->
<view class="page">
  <navbar title="艾宾浩斯背单词"></navbar>

  <scroll-view scroll-y class="scroller" enhanced show-scrollbar="{{false}}">

    <!-- FSRS 头卡 -->
    <view class="head-card">
      <view>
        <view class="head-label">今日艾宾浩斯复习流</view>
        <view class="head-stat">待复习 {{due}} · 已复习 {{done}}</view>
      </view>
      <view class="head-badge">艾宾浩斯</view>
    </view>

    <!-- 翻转闪卡 -->
    <view class="flip-wrap">
      <view class="flip-card {{flipped ? 'is-flipped' : ''}}" bindtap="flip">
        <!-- 正面 -->
        <view class="face face-front">
          <view class="stage-pill">{{card.stage}}</view>
          <view class="card-emoji">{{card.emoji}}</view>
          <view class="front-mid">
            <view class="card-word">{{card.word}}</view>
            <view class="phonics-pill">自然拼读：{{card.phonics}}</view>
          </view>
          <view class="flip-hint">点击卡片翻面看释义 👆</view>
        </view>
        <!-- 背面 -->
        <view class="face face-back">
          <view class="back-mid">
            <view class="card-mean">{{card.mean}}</view>
            <view class="card-example">{{card.example}}</view>
          </view>
          <view class="eval-grid">
            <view
              wx:for="{{evals}}"
              wx:key="k"
              class="eval-btn {{item.cls}}"
              data-grade="{{index + 1}}"
              catchtap="onEval">{{item.k}} · {{item.sub}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="export-actions">
      <button class="export-btn" bindtap="onExport">下载单词表 CSV</button>
      <button class="export-btn primary" bindtap="onPrint">打印 / 保存 PDF</button>
    </view>

    <!-- 单词图鉴进度 -->
    <view class="atlas">
      <view class="atlas-left">
        <text class="atlas-emoji">📔</text>
        <view>
          <view class="atlas-title">单词图鉴</view>
          <view class="atlas-sub">已收集 {{collected}} / {{total}}</view>
        </view>
      </view>
      <view class="atlas-bar"><view class="atlas-fill" style="width:{{percent}}%"></view></view>
    </view>

    <view class="tail"></view>
  </scroll-view>
</view>
