/* 我的 · 探险家档案 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F6F8;
}
.scroller { flex: 1; }
.tail { height: 40rpx; }
.pressed { transform: scale(.97); transition: transform .1s; }

/* 资料卡 */
.profile {
  margin: 24rpx;
  border-radius: 40rpx;
  padding: 32rpx;
  background: linear-gradient(90deg, #FF6FA5, #FF6B4A);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 6rpx 18rpx rgba(43, 47, 56, .07);
}
.profile-left { display: flex; align-items: center; gap: 20rpx; }
.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .25);
  display: flex;
  align-items: center;
  justify-content: center;
}
.profile-name { font-size: 32rpx; font-weight: 800; }
.profile-sub { font-size: 22rpx; opacity: .92; margin-top: 4rpx; }
.profile-shop {
  background: rgba(255, 255, 255, .25);
  font-size: 24rpx;
  font-weight: 700;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
}

/* 卡片 */
.card {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(43, 47, 56, .07);
}
.card-title { font-size: 28rpx; font-weight: 800; color: #2B2F38; margin-bottom: 24rpx; }

/* 徽章网格 */
.badges {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
  text-align: center;
}
.badge { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.badge-ico {
  width: 108rpx;
  height: 108rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: 0 6rpx 14rpx rgba(43, 47, 56, .1);
}
.bg-grass { background: linear-gradient(135deg, #86EFAC, #34D399); }
.bg-amber { background: linear-gradient(135deg, #FCD34D, #FB923C); }
.bg-rose  { background: linear-gradient(135deg, #FCA5A5, #FB7185); }
.bg-sky   { background: linear-gradient(135deg, #7DD3FC, #60A5FA); }
.badge-lock { background: #F1F5F9; box-shadow: none; opacity: .5; filter: grayscale(1); }
.badge-label { font-size: 18rpx; font-weight: 700; color: #2B2F38; }
.label-lock { color: #8A93A2; font-weight: 400; }

/* 家长入口 */
.parent-btn {
  margin: 24rpx;
  background: #fff;
  color: #2B2F38;
  font-size: 28rpx;
  font-weight: 800;
  text-align: center;
  padding: 30rpx 0;
  border-radius: 32rpx;
  box-shadow: 0 6rpx 18rpx rgba(43, 47, 56, .07);
}
