<!-- 我的 · 探险家档案（Tab 页） -->
<view class="q-page">
  <scroll-view scroll-y class="scroller" enhanced show-scrollbar="{{false}}">

    <!-- 资料卡 -->
    <view class="profile" style="padding-top:calc({{statusBarH}}px + 28rpx)">
      <view class="profile-left">
        <view class="profile-avatar"><mascot type="me" face="happy" style="width:88rpx;height:88rpx" /></view>
        <view>
          <view class="profile-name">小小探险家 · Lv.{{profile.level}}</view>
          <view class="profile-sub">🪙 {{profile.coin}} · 连续学习 {{profile.streak}} 天</view>
        </view>
      </view>
      <view class="profile-shop" hover-class="pressed" bindtap="openShop">商城</view>
    </view>

    <!-- 今日快照 -->
    <view class="section stats">
      <view class="stat" wx:for="{{stats}}" wx:key="k">
        <view class="stat-v">{{item.v}}</view>
        <view class="stat-k">{{item.k}}</view>
      </view>
    </view>

    <!-- 成就徽章 -->
    <view class="section">
      <view class="card">
        <view class="card-title">🏅 我的成就徽章</view>
        <view class="badges">
          <view class="badge" wx:for="{{badges}}" wx:key="index">
            <view class="badge-ico {{item.lock ? 'badge-lock' : item.cls}}">{{item.emoji}}</view>
            <text class="badge-label {{item.lock ? 'label-lock' : ''}}">{{item.label}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 功能入口 -->
    <view class="section entries">
      <view class="entry" hover-class="pressed" bindtap="openReport">
        <text class="entry-ico">📈</text><text class="entry-label">成长报告</text><text class="entry-arrow">›</text>
      </view>
      <view class="entry" hover-class="pressed" bindtap="openParent">
        <text class="entry-ico">👨‍👩‍👧</text><text class="entry-label">家长控制台</text><text class="entry-arrow">›</text>
      </view>
      <view class="entry" hover-class="pressed" bindtap="openSettings">
        <text class="entry-ico">⚙️</text><text class="entry-label">设置</text><text class="entry-arrow">›</text>
      </view>
    </view>

    <view class="tab-spacer"></view>
  </scroll-view>

  <tabbar active="me" />
</view>
