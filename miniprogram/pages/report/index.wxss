/* 头部 */
.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 34rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #35B979, #2FA76C);
  box-shadow: 0 14rpx 30rpx rgba(53, 185, 121, .26);
}
.hero-num { font-size: 76rpx; font-weight: 800; color: #fff; line-height: 1; }
.hero-label { font-size: 24rpx; color: rgba(255, 255, 255, .9); margin-top: 8rpx; }
.hero-mascot { width: 120rpx; height: 120rpx; }

/* 三维数据 */
.metrics { display: flex; gap: 18rpx; }
.metric {
  flex: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 26rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(42, 72, 126, .07);
}
.metric-emoji { font-size: 40rpx; }
.metric-v { font-size: 40rpx; font-weight: 800; color: #202634; margin-top: 6rpx; }
.metric-k { font-size: 22rpx; color: #7D8799; margin-top: 2rpx; }

/* 卡片 */
.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 22rpx rgba(42, 72, 126, .08);
}
.card-title { font-size: 26rpx; font-weight: 800; color: #202634; margin-bottom: 24rpx; }

/* 柱状图 */
.chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 260rpx;
  padding-top: 20rpx;
}
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 8rpx; }
.bar-val { font-size: 18rpx; color: #7D8799; }
.bar {
  width: 40rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  background: linear-gradient(180deg, #6AA9FF, #3D8BFF);
  transition: height .4s;
}
.bar-day { font-size: 20rpx; color: #7D8799; }

/* 建议 */
.advice {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  padding: 26rpx 28rpx;
  background: #FFF9EC;
  border: 1rpx solid #FFE7B3;
  border-radius: 28rpx;
}
.advice-ava {
  width: 84rpx; height: 84rpx; flex: none;
  border-radius: 22rpx;
  background: #FFF0CF;
  display: grid; place-items: center;
}
.advice-title { font-size: 26rpx; font-weight: 800; color: #8A5A12; }
.advice-body { font-size: 24rpx; color: #A2761F; line-height: 1.6; margin-top: 6rpx; }
