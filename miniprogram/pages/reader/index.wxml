<!-- 绘本阅读器 -->
<view class="q-page">
  <navbar title="{{book.title}}" />

  <scroll-view scroll-y class="scroller" enhanced show-scrollbar="{{false}}">
    <!-- 阅读器卡 -->
    <view class="reader-card anim-in">
      <view class="reader-head">
        <text class="lv-pill">Level {{book.level}}</text>
        <text class="book-page">{{book.page}} / {{book.total}}</text>
      </view>

      <view class="book-art">{{book.scene}}</view>

      <!-- 进度点 -->
      <view class="dots">
        <text class="dot {{index + 1 <= book.page ? 'dot-on' : ''}}" wx:for="{{book.total}}" wx:key="*this"></text>
      </view>

      <view class="sentence">
        <block wx:for="{{tokens}}" wx:key="index">
          <text
            wx:if="{{item.w}}"
            class="word word-{{item.hl}} {{added[item.t] ? 'word-got' : ''}}"
            data-i="{{index}}"
            bindtap="onWordTap">{{item.t}}</text>
          <text wx:else>{{item.t}}</text>
        </block>
      </view>
    </view>

    <view class="reader-hint">点亮的单词可点开查词，一键收进生词本 👆</view>
    <view class="tail"></view>
  </scroll-view>

  <!-- 底部操作条 -->
  <view class="reader-bar" style="padding-bottom: calc(20rpx + env(safe-area-inset-bottom))">
    <view class="rbtn rbtn-gray {{book.page <= 1 ? 'rbtn-off' : ''}}" data-d="-1" bindtap="changePage">◄</view>
    <view class="rbtn rbtn-read {{recording ? 'rbtn-rec' : ''}}" bindtap="onReadAlong">
      <text wx:if="{{recording}}">● 录音中·松开评分</text>
      <text wx:else>🎙️ 跟读打分</text>
    </view>
    <view class="rbtn rbtn-gray {{book.page >= book.total ? 'rbtn-off' : ''}}" data-d="1" bindtap="changePage">►</view>
  </view>

  <!-- 查词弹窗 -->
  <view wx:if="{{wordModal}}" class="mask" bindtap="closeWordModal">
    <view class="modal anim-pop" catchtap="noop">
      <view class="w-word">{{word.t}}</view>
      <view class="w-ph">🔊 {{word.ph}}</view>
      <view class="w-mean">{{word.mean}}</view>
      <view class="modal-btn modal-btn-grass" bindtap="addToWordbook">+ 加入生词本</view>
    </view>
  </view>

  <!-- 跟读评分结果 -->
  <view wx:if="{{scoreModal}}" class="mask" bindtap="closeScore">
    <view class="modal score-modal anim-pop" catchtap="noop">
      <view class="score-mascot"><mascot type="cheer" face="wow" style="width:170rpx;height:170rpx" /></view>
      <view class="score-num">跟读得分 {{score}} 🌟</view>
      <view class="score-sub">发音清晰！解锁徽章 🏅 {{badge}}</view>
      <view class="modal-btn modal-btn-coral" bindtap="closeScore">太棒了！</view>
    </view>
  </view>

  <!-- 跟读 loading -->
  <view wx:if="{{loading}}" class="loading-mask">
    <view class="anim-bob"><mascot type="hero" face="sleepy" style="width:160rpx;height:160rpx" /></view>
    <view class="loading-msg">跟读评分中…</view>
  </view>
</view>
