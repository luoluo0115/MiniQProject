.scroller { height: calc(100vh - 88rpx - 44px); }

.reader-card {
  margin: 24rpx 28rpx 0;
  padding: 30rpx;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 16rpx 36rpx rgba(42, 72, 126, .1);
}
.reader-head { display: flex; align-items: center; justify-content: space-between; }
.lv-pill {
  font-size: 22rpx;
  font-weight: 800;
  color: #fff;
  background: #3D8BFF;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}
.book-page { font-size: 24rpx; font-weight: 800; color: #7D8799; }

.book-art {
  height: 300rpx;
  margin: 24rpx 0;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #EAF3FF, #F3ECFF);
  display: grid;
  place-items: center;
  font-size: 150rpx;
}

.dots { display: flex; justify-content: center; gap: 10rpx; margin-bottom: 22rpx; }
.dot { width: 14rpx; height: 14rpx; border-radius: 999rpx; background: #E1E7F2; transition: all .2s; }
.dot-on { width: 34rpx; background: #3D8BFF; }

.sentence { font-size: 42rpx; line-height: 1.7; color: #202634; font-weight: 600; letter-spacing: .5rpx; }
.word { padding: 0 4rpx; border-radius: 8rpx; }
.word-amber { background: #FFF0CF; color: #A9701A; }
.word-sky   { background: #E1EEFF; color: #2C6FD6; }
.word-grass { background: #DFF6E9; color: #1E9A5F; }
.word-coral { background: #FFE6DC; color: #D6512F; }
.word-sunny { background: #FFF3CF; color: #A9701A; }
.word-pinky { background: #FFE4EC; color: #D24B72; }
.word-grape { background: #EBE6FF; color: #6355C9; }
.word-got { box-shadow: inset 0 -6rpx 0 rgba(53, 185, 121, .4); }

.reader-hint { text-align: center; color: #7D8799; font-size: 22rpx; margin-top: 24rpx; }
.tail { height: 40rpx; }

/* 底部操作条 */
.reader-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 28rpx;
  background: rgba(255, 255, 255, .96);
  border-top: 1rpx solid rgba(95, 147, 188, .12);
  backdrop-filter: blur(10rpx);
}
.rbtn {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 800;
}
.rbtn-gray { width: 100rpx; flex: none; background: #F1F5F9; color: #4B5567; font-size: 40rpx; }
.rbtn-off { opacity: .35; }
.rbtn-read { flex: 1; background: linear-gradient(135deg, #35B979, #2FA76C); color: #fff; box-shadow: 0 10rpx 22rpx rgba(53, 185, 121, .3); }
.rbtn-rec { background: linear-gradient(135deg, #FF704E, #FF5470); animation: m-bob 1s ease-in-out infinite; }

/* 弹窗 */
.mask {
  position: fixed; inset: 0; z-index: 100;
  background: rgba(24, 32, 52, .5);
  display: grid; place-items: center;
}
.modal {
  width: 560rpx;
  padding: 40rpx 36rpx;
  background: #fff;
  border-radius: 32rpx;
  text-align: center;
  box-shadow: 0 30rpx 80rpx rgba(20, 32, 66, .35);
}
.w-word { font-size: 52rpx; font-weight: 800; color: #202634; }
.w-ph { font-size: 26rpx; color: #7D8799; margin-top: 10rpx; }
.w-mean { font-size: 32rpx; color: #3D8BFF; font-weight: 700; margin: 18rpx 0 26rpx; }
.modal-btn {
  padding: 22rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #fff;
}
.modal-btn-grass { background: linear-gradient(135deg, #35B979, #2FA76C); }
.modal-btn-coral { background: linear-gradient(135deg, #FF6B8B, #FF704E); }

.score-modal { background: linear-gradient(180deg, #FFF6F2, #fff); }
.score-mascot { display: flex; justify-content: center; }
.score-num { font-size: 42rpx; font-weight: 800; color: #202634; margin-top: 8rpx; }
.score-sub { font-size: 24rpx; color: #7D8799; margin: 12rpx 0 26rpx; }

.loading-mask {
  position: fixed; inset: 0; z-index: 110;
  background: rgba(255, 255, 255, .82);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20rpx;
}
.loading-msg {
  font-size: 24rpx; font-weight: 700; color: #7968ED;
  background: #EFECFF; padding: 12rpx 28rpx; border-radius: 999rpx;
}
