/* 星学院 · 绘本阅读器 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F6F8;
}
.scroller { flex: 1; }
.tail { height: 40rpx; }

/* 分级筛选 */
.levels { width: 100%; white-space: nowrap; margin-top: 20rpx; }
.levels-row { display: inline-flex; gap: 16rpx; padding: 0 24rpx; }
.level-chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #8A93A2;
  font-size: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(43, 47, 56, .07);
}
.level-on { background: #4FB5F0; color: #fff; font-weight: 700; box-shadow: none; }
.level-ear { color: #2B2F38; }

/* 阅读器卡 */
.reader-card {
  margin: 24rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(43, 47, 56, .07);
}
.reader-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.book-title { font-size: 28rpx; font-weight: 800; color: #4FB5F0; }
.book-page { font-size: 24rpx; font-weight: 700; color: #8A93A2; }
.book-art {
  width: 100%;
  height: 352rpx;
  background: #ECFDF5;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
  margin-bottom: 24rpx;
}
.sentence {
  background: #F8FAFC;
  border-radius: 32rpx;
  padding: 26rpx;
  font-size: 32rpx;
  line-height: 1.9;
  color: #2B2F38;
}
.word {
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  font-weight: 700;
}
.word-amber { background: #FEF3C7; color: #92400E; }
.word-sky { background: #BAE6FD; color: #075985; text-decoration: underline; }

.reader-btns {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
  gap: 16rpx;
}
.rbtn {
  font-size: 24rpx;
  font-weight: 700;
  padding: 18rpx 0;
  border-radius: 20rpx;
  text-align: center;
}
.rbtn-gray { background: #F1F5F9; color: #2B2F38; flex: 0 0 auto; padding-left: 24rpx; padding-right: 24rpx; }
.rbtn-read {
  flex: 1;
  background: linear-gradient(90deg, #4FC378, #10B981);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(16, 185, 129, .28);
}
.rbtn-next { background: #4FB5F0; color: #fff; flex: 0 0 auto; padding-left: 24rpx; padding-right: 24rpx; }

.reader-hint {
  text-align: center;
  font-size: 22rpx;
  color: #8A93A2;
  margin-top: 8rpx;
}

/* 弹窗通用 */
.mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  background: rgba(0, 0, 0, .45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
.modal {
  width: 100%;
  max-width: 560rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 40rpx;
  text-align: center;
  box-shadow: 0 10rpx 26rpx rgba(43, 47, 56, .18);
}
.modal-btn {
  margin-top: 24rpx;
  width: 100%;
  padding: 22rpx 0;
  border-radius: 28rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #fff;
}
.modal-btn-grass { background: #4FC378; }
.modal-btn-coral { background: linear-gradient(90deg, #FF6FA5, #FF6B4A); }

/* 查词 */
.w-word { font-size: 44rpx; font-weight: 800; color: #4FB5F0; }
.w-ph { font-size: 22rpx; color: #8A93A2; margin-top: 4rpx; }
.w-mean { font-size: 30rpx; font-weight: 700; color: #2B2F38; margin-top: 12rpx; }

/* 评分 */
.score-mascot { display: flex; justify-content: center; margin-top: -12rpx; }
.score-num { font-size: 36rpx; font-weight: 800; color: #FF6B4A; margin-top: 8rpx; }
.score-sub { font-size: 24rpx; color: #8A93A2; margin-top: 8rpx; }

/* loading */
.loading-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  background: rgba(0, 0, 0, .25);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.loading-msg {
  margin-top: 12rpx;
  background: rgba(255, 255, 255, .96);
  color: #2B2F38;
  font-size: 24rpx;
  font-weight: 700;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
}
