/* 小Q首页 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F3F7FF;
}

.pressed { transform: scale(.96); transition: transform .1s; }

/* ---------- 顶栏 ---------- */
.topbar {
  background: rgba(255, 255, 255, .96);
  backdrop-filter: blur(10rpx);
  border-bottom: 1rpx solid #F1F2F4;
}
.topbar-inner {
  height: 88rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}
.city { font-size: 24rpx; font-weight: 500; color: #2B2F38; }
.chev { font-size: 20rpx; color: #8A93A2; }
.logo {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.logo-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 3rpx;
}
.dot { width: 18rpx; height: 18rpx; border-radius: 5rpx; }
.dot-grass { background: #35B979; }
.dot-sky   { background: #3D8BFF; }
.dot-sunny { background: #FFCA4B; }
.dot-coral { background: #FF704E; }
.logo-text { font-size: 30rpx; font-weight: 800; color: #2B2F38; }
.capsule {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, .05);
  border: 1rpx solid rgba(0, 0, 0, .08);
  font-size: 24rpx;
  color: #2B2F38;
}
.cap-sep { width: 1rpx; height: 24rpx; background: rgba(0, 0, 0, .15); }

/* ---------- 滚动区 ---------- */
.scroller { flex: 1; }
.section { padding: 0 24rpx; margin-top: 28rpx; }
.tab-spacer { height: 180rpx; }

/* ---------- Hero ---------- */
.hero-wrap { margin-top: 22rpx; }
.hero-card {
  position: relative;
  border-radius: 40rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 18rpx rgba(43, 47, 56, .07);
  line-height: 0;
}
.hero-img { width: 100%; display: block; }
.hero-title { position: absolute; top: 26rpx; left: 32rpx; }
.hero-h1 {
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1;
  text-shadow: 0 2rpx 0 rgba(255, 120, 60, .6), 0 5rpx 8rpx rgba(0, 0, 0, .16);
}
.hero-h2 {
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 12rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, .28);
}

/* ---------- 九宫格 ---------- */
.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  row-gap: 30rpx;
  column-gap: 8rpx;
}
.grid-item { text-align: center; }
.bubble {
  width: 108rpx;
  height: 108rpx;
  margin: 0 auto;
  border-radius: 999rpx;
  padding: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 -8rpx 16rpx rgba(0, 0, 0, .06);
}
.bubble-read    { background: linear-gradient(135deg, #E0F0FE, #BEE1FD); }
.bubble-library { background: linear-gradient(135deg, #DCFCE7, #BBF7D0); }
.bubble-vocab   { background: linear-gradient(135deg, #F3E8FF, #E9D5FF); }
.bubble-ai      { background: linear-gradient(135deg, #FCE7F3, #FBCFE8); }
.bubble-ear     { background: linear-gradient(135deg, #CFFAFE, #A5F3FC); }
.bubble-test    { background: linear-gradient(135deg, #EDE9FE, #DDD6FE); }
.bubble-invite  { background: linear-gradient(135deg, #CCFBF1, #99F6E4); }
.grid-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #2B2F38;
  margin-top: 12rpx;
}

/* ---------- 卡片通用 ---------- */
.card {
  background: #fff;
  border-radius: 40rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(43, 47, 56, .07);
}

/* ---------- 今日计划 ---------- */
.plan-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.plan-title { font-size: 32rpx; font-weight: 800; color: #2B2F38; }
.level-pill {
  background: rgba(53, 185, 121, .15);
  color: #35B979;
  font-size: 22rpx;
  font-weight: 700;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}
.plan-list { display: flex; flex-direction: column; gap: 12rpx; }
.plan-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F8FAFC;
  padding: 20rpx;
  border-radius: 28rpx;
}
.plan-text { font-size: 24rpx; font-weight: 700; color: #2B2F38; }
.plan-reason { margin: -8rpx 0 14rpx 48rpx; font-size: 20rpx; color: #8A93A2; }
.plan-coin { font-size: 28rpx; font-weight: 800; color: #E0A61E; }
.btn-start {
  margin-top: 24rpx;
  width: 100%;
  background: linear-gradient(135deg, #FF6B8B, #FF704E);
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  padding: 22rpx 0;
  border-radius: 28rpx;
  line-height: 1.4;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 74, .28);
}
.btn-start::after { border: none; }

/* ---------- 功能卡片横滑 ---------- */
.cards-scroll { width: 100%; white-space: nowrap; }
.cards-row { display: inline-flex; gap: 22rpx; padding-bottom: 6rpx; }
.fcard {
  width: 300rpx;
  height: 176rpx;
  border-radius: 32rpx;
  padding: 24rpx;
  display: inline-flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: 0 6rpx 18rpx rgba(43, 47, 56, .07);
}
.card-green  { background: linear-gradient(135deg, #34D399, #10B981); }
.card-blue   { background: linear-gradient(135deg, #38BDF8, #3B82F6); }
.card-orange { background: linear-gradient(135deg, #FBBF24, #F97316); }
.fcard-emoji { font-size: 48rpx; }
.fcard-tag {
  align-self: flex-start;
  background: rgba(255, 255, 255, .92);
  color: #1F2937;
  font-size: 22rpx;
  font-weight: 700;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

/* ---------- 品牌专区 ---------- */
.brand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 32rpx;
  padding: 32rpx;
  background: linear-gradient(90deg, #FEF08A, #FDE68A 55%, #FEF9C3);
  box-shadow: 0 6rpx 18rpx rgba(43, 47, 56, .07);
}
.brand-title { font-size: 36rpx; font-weight: 800; color: #92400E; }
.brand-sub { font-size: 22rpx; color: rgba(146, 64, 14, .8); margin-top: 4rpx; }
.brand-emoji { font-size: 64rpx; }
