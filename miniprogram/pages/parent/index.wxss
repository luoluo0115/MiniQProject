/* 家长控制台 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F3F7FF;
}
.scroller { flex: 1; }
.tail { height: 40rpx; }
.pressed { transform: scale(.98); }

.card {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 22rpx rgba(42, 72, 126, .08);
}
.card-title { font-size: 30rpx; font-weight: 800; color: #35B979; margin-bottom: 20rpx; }

/* 管控行 */
.ctrl-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F5F8FC;
  border-radius: 22rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.ctrl-row:last-child { margin-bottom: 0; }
.ctrl-name { font-size: 28rpx; font-weight: 700; color: #202634; }
.ctrl-sub { font-size: 22rpx; color: #7D8799; margin-top: 4rpx; }

/* 周报 */
.report {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  text-align: center;
}
.stat { border-radius: 22rpx; padding: 28rpx 0; }
.stat-grass { background: #E5F8EE; }
.stat-sunny { background: #FFF7E0; }
.stat-pinky { background: #FFEFF4; }
.stat-num { font-size: 40rpx; font-weight: 800; }
.stat-grass .stat-num { color: #35B979; }
.stat-sunny .stat-num { color: #E0A61E; }
.stat-pinky .stat-num { color: #FF6B8B; }
.stat-label { font-size: 20rpx; color: #7D8799; margin-top: 6rpx; }

/* 报告入口 */
.report-entry {
  margin: 20rpx 24rpx 0;
  padding: 28rpx;
  text-align: center;
  background: #fff;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #3D8BFF;
  box-shadow: 0 8rpx 20rpx rgba(42, 72, 126, .06);
}
