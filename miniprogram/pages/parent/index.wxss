/* 家长控制台 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F6F8;
}
.scroller { flex: 1; }
.tail { height: 40rpx; }

.card {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 40rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(43, 47, 56, .07);
}
.card-title { font-size: 30rpx; font-weight: 800; color: #4FC378; margin-bottom: 20rpx; }

/* 管控行 */
.ctrl-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F8FAFC;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.ctrl-row:last-child { margin-bottom: 0; }
.ctrl-name { font-size: 28rpx; font-weight: 700; color: #2B2F38; }
.ctrl-sub { font-size: 22rpx; color: #8A93A2; margin-top: 4rpx; }

/* 周报 */
.report {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  text-align: center;
}
.stat { border-radius: 28rpx; padding: 28rpx 0; }
.stat-grass { background: #ECFDF5; }
.stat-sunny { background: #FFFBEB; }
.stat-pinky { background: #FDF2F8; }
.stat-num { font-size: 40rpx; font-weight: 800; }
.stat-grass .stat-num { color: #4FC378; }
.stat-sunny .stat-num { color: #FFC93C; }
.stat-pinky .stat-num { color: #FF6FA5; }
.stat-label { font-size: 20rpx; color: #8A93A2; margin-top: 6rpx; }
